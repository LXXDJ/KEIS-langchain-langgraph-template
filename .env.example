# ── 프로젝트 환경변수 ────────────────────────────────────────────
# 이 파일을 복사해서 .env로 만들어 사용하세요:
#   cp .env.example .env

# ── LLM API 키 ───────────────────────────────────────────────
# chat / deep_research preset 사용 시 필요
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── 백엔드 설정 ───────────────────────────────────────────────
# 에이전트가 파일을 쓸 출력 디렉토리 (기본값: ./outputs)
# AGENT_OUTPUT_DIR=./outputs

# ── 서버 설정 ─────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
