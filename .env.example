# ── 프로젝트 환경변수 ────────────────────────────────────────────
# 이 파일을 복사해서 .env로 만들어 사용하세요:
#   cp .env.example .env

# ── Preset 선택 ───────────────────────────────────────────────
# "custom"        : LLM 없이 테스트용 (기본값)
# "chat"          : langchain create_agent() 기반
# "deep_research" : deepagents create_deep_agent() 기반
AGENT_PRESET=chat

# ── LLM API 키 ───────────────────────────────────────────────
# chat / deep_research preset 사용 시 필요
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── 서버 설정 ─────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
