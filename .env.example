# ── 프로젝트 환경변수 ────────────────────────────────────────────
# 이 파일을 복사해서 .env로 만들어 사용하세요:
#   cp .env.example .env

# ── LLM API 키 (필수) ────────────────────────────────────────
# 의도 분류와 한국어 요약에 GPT-4o mini를 사용합니다.
OPENAI_API_KEY=sk-your-key-here

# ── LLM 모델 (선택) ──────────────────────────────────────────
# init_chat_model 형식: "provider:model-id"
# - 미설정 시 기본값: openai:gpt-4o-mini
# - prefix 없이 모델명만 적으면 자동으로 openai 로 가정 (예: gpt-4o-mini)
# - 알려진 provider: openai, anthropic, google_genai, azure_openai, bedrock,
#   cohere, fireworks, groq, huggingface, mistralai, ollama, together, xai
#
# 예시:
# LLM_MODEL=openai:gpt-4o-mini
# LLM_MODEL=openai:gpt-4o
# LLM_MODEL=anthropic:claude-haiku-4-5-20251001

# ── 서버 설정 (선택) ──────────────────────────────────────────
# scripts/run-local.sh, app/run.py 모두 아래 값을 우선 사용하며,
# 미설정 시 괄호 안의 기본값으로 동작합니다.
# HOST=0.0.0.0
# PORT=8000
# RELOAD=true
