# ── 프로젝트 환경변수 ────────────────────────────────────────────
# 이 파일을 복사해서 .env로 만들어 사용하세요:
#   cp .env.example .env

# ── LLM API 키 (필수) ────────────────────────────────────────
# 의도 분류와 한국어 요약에 GPT-4o mini를 사용합니다.
OPENAI_API_KEY=sk-your-key-here

# ── LLM 모델 (선택) ──────────────────────────────────────────
# init_chat_model 형식: "provider:model-id"
# - 미설정 시 기본값: openai:gpt-4o-mini
# - prefix 없이 모델명만 적으면 자동으로 openai 로 가정 (예: gpt-4o-mini)
# - 알려진 provider: openai, anthropic, google_genai, azure_openai, bedrock,
#   cohere, fireworks, groq, huggingface, mistralai, ollama, together, xai
#
# 예시:
# LLM_MODEL=openai:gpt-4o-mini
# LLM_MODEL=openai:gpt-4o
# LLM_MODEL=anthropic:claude-haiku-4-5-20251001

# ── 결과 개수 (선택) ─────────────────────────────────────────
# SEARCH_RESULT_COUNT — work24 에서 카테고리당 받아올 결과 개수 (기본 20)
#   · 값이 클수록 navigation(원문 URL, 추가 탐색 경로)이 풍부해진다.
#   · 9개 카테고리 × 이 값 = 이론적 최대치. 실제로는 카테고리별로 결과가
#     없을 수 있어 더 적게 돌아온다.
# SUMMARY_INPUT_COUNT — 요약 LLM 에 입력으로 넘길 결과 개수 (기본 5)
#   · 카테고리 우선순위 정렬 후 상위 N건만 LLM 컨텍스트로 들어간다.
#   · 값이 클수록 요약 풍부, 토큰·지연·비용 ↑.
# 두 값 모두 1~100 범위 정수만 허용. 잘못된 값은 그래프 첫 호출 시점에
# _InvalidCountError 로 즉시 실패한다.
# SEARCH_RESULT_COUNT=20
# SUMMARY_INPUT_COUNT=5

# ── 서버 설정 (선택) ──────────────────────────────────────────
# scripts/run-local.sh, app/run.py 모두 아래 값을 우선 사용하며,
# 미설정 시 괄호 안의 기본값으로 동작합니다.
# HOST=0.0.0.0
# PORT=8000
# RELOAD=true
